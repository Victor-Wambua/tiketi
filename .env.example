# Copy to .env and edit. None of these are real secrets; all defaults work for local use.
PORT=8787
DATABASE_PATH=data/tiketi.db
# Ed25519 signing key (PEM, pkcs8). If unset, one is generated into data/ticket-key.pem on first start.
TICKET_KEY_PATH=data/ticket-key.pem
# Shared secret used to HMAC-sign the (mock) M-Pesa callbacks.
MPESA_CALLBACK_SECRET=dev-only-callback-secret
# Hold lifetime in seconds (default 10 minutes).
HOLD_TTL_SECONDS=600
# Mock STK: seconds before an unanswered prompt times out.
MOCK_STK_TIMEOUT_SECONDS=60
# Set to 1 to serve the mock phone simulator endpoints (default on; there is no real provider).
MOCK_PAYMENTS=1
